# ─────────────────────────────────────────────────────────────────────────────
# TechFix Peshawar — Production Environment Configuration (.env.example)
# Copy this file to .env and populate with your credentials.
# Never commit .env with real secrets to version control!
# ─────────────────────────────────────────────────────────────────────────────

# ─── 1. Frontend (Vite) Firebase Configuration ──────────────────────────────
# Obtain these from: Firebase Console → Project Settings → General → Your apps (Web)
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"
# Only set if using a named Firestore database instance instead of '(default)':
VITE_FIREBASE_DATABASE_ID="ai-studio-peshawaronsitete-70e75457-6a23-4284-84ee-9bd0ef9c4555"

# ─── 2. Backend Firebase Admin SDK (Privileged Server Operations) ───────────
# Used for server-side privileged Firestore writes, admin settings, and bookings.
# Obtain from: Firebase Console → Project Settings → Service accounts → Generate new private key
# Option A: Individual service account variables (recommended for Vercel):
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
# Option B: Base64-encoded JSON service account file:
# FIREBASE_SERVICE_ACCOUNT_BASE64="eyJwcm9qZWN0X2lkIjoi..."
# Named database (matches VITE_FIREBASE_DATABASE_ID if applicable):
FIREBASE_DATABASE_ID="ai-studio-peshawaronsitete-70e75457-6a23-4284-84ee-9bd0ef9c4555"

# ─── 3. Admin Security & Authentication ──────────────────────────────────────
# Master admin login password & HMAC token secret:
ADMIN_PASSWORD="YourStrongAdminPasswordHere"
ADMIN_EMAIL="techfixpeshawar@gmail.com"
API_SECRET="your_random_cryptographic_jwt_hmac_secret_salt_32chars"

# ─── 4. Resend Email Integration ─────────────────────────────────────────────
# Obtain API key from: https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# For unverified domains, use: "TechFix Support <onboarding@resend.dev>"
# For verified custom domains: "TechFix Support <support@techfixpeshawar.com>"
RESEND_FROM="TechFix Support <onboarding@resend.dev>"
FROM_EMAIL="TechFix Support <onboarding@resend.dev>"

# ─── 5. SMTP / Google Gmail Integration ──────────────────────────────────────
# Google Gmail 16-character App Password (Free 500 emails/day, 100% Primary Inbox):
# Generate at: https://myaccount.google.com/apppasswords (Requires Google 2-Step Verification)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
GMAIL_USER="techfixpeshawar@gmail.com"
GMAIL_ADDRESS="techfixpeshawar@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
GOOGLE_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# ─── 6. Destination Notification Target ─────────────────────────────────────
# Where customer booking alerts & inquiries are delivered:
TARGET_EMAIL="techfixpeshawar@gmail.com"
NOTIFICATION_TARGET_EMAIL="techfixpeshawar@gmail.com"
