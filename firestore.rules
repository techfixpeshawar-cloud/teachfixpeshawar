rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── PUBLIC CONTENT & ADMIN CMS (real-time sync) ─────────────────────────

    match /services/{serviceId} {
      allow read, write: if true;
    }

    match /solutions/{solutionId} {
      allow read, write: if true;
    }

    match /categories/{categoryId} {
      allow read, write: if true;
    }

    match /faq/{faqId} {
      allow read, write: if true;
    }

    match /caseStudies/{caseStudyId} {
      allow read, write: if true;
    }

    match /page_sections/{sectionId} {
      allow read, write: if true;
    }

    match /media/{mediaId} {
      allow read, write: if true;
    }

    // ─── SETTINGS (admin settings & site config) ────────────────────────────

    match /settings/{settingId} {
      allow read, write: if true;
    }

    // ─── PROBLEM LEADS ──────────────────────────────────────────────────────

    match /problem-leads/{leadId} {
      allow read, write: if true;
    }

    // ─── CUSTOMER SUBMISSIONS (bookings, inquiries, requests) ───────────────

    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    match /serviceRequests/{requestId} {
      allow read, write: if true;
    }

    match /requests/{requestId} {
      allow read, write: if true;
    }

    match /inquiries/{inquiryId} {
      allow read, write: if true;
    }

    match /contacts/{contactId} {
      allow read, write: if true;
    }

    // ─── ADMIN DATA ─────────────────────────────────────────────────────────

    match /customers/{customerId} {
      allow read, write: if true;
    }

    match /activityLogs/{logId} {
      allow read, write: if true;
    }

    match /activities/{activityId} {
      allow read, write: if true;
    }

    match /leads/{leadId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    // ─── CATCH-ALL PERMISSIVE FOR APP COLLECTIONS ───────────────────────────

    match /{document=**} {
      allow read, write: if true;
    }
  }
}