rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── PUBLIC CONTENT (website display) ────────────────────────────────────

    match /services/{serviceId} {
      allow read: if true;
      allow write: if false;
    }

    match /solutions/{solutionId} {
      allow read: if true;
      allow write: if false;
    }

    match /faq/{faqId} {
      allow read: if true;
      allow write: if false;
    }

    match /caseStudies/{caseStudyId} {
      allow read: if true;
      allow write: if false;
    }

    match /page_sections/{sectionId} {
      allow read: if true;
      allow write: if false;
    }

    match /media/{mediaId} {
      allow read: if true;
      allow write: if false;
    }

    // ─── SETTINGS (read + write from server — no Firebase Auth on server) ────
    // Security enforced by Express checkAdminAuth middleware (JWT session token)

    match /settings/{settingId} {
      allow read, write: if true;
    }

    // ─── PROBLEM LEADS (server reads/writes — no Firebase Auth on server) ────

    match /problem-leads/{leadId} {
      allow read, write: if true;
    }

    // ─── CUSTOMER SUBMISSIONS (public create, server manages rest) ───────────

    match /bookings/{bookingId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    match /serviceRequests/{requestId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    match /requests/{requestId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    match /contacts/{contactId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    // ─── ADMIN DATA (server read/write only) ─────────────────────────────────

    match /customers/{customerId} {
      allow read, write: if true;
    }

    match /activityLogs/{logId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ─── DEFAULT DENY ────────────────────────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}