rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'ullahsafiullah117@gmail.com' ||
        request.auth.token.email == 'sullahjan40@gmail.com' ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    // PUBLIC CONTENT

    match /services/{serviceId} {
      allow read: if
        resource.data.status == 'PUBLISHED' ||
        resource.data.status == 'published' ||
        resource.data.status == 'active' ||
        isAdmin();

      allow write: if isAdmin();
    }

    match /faq/{faqId} {
      allow read: if
        resource.data.status == 'PUBLISHED' ||
        resource.data.status == 'published' ||
        resource.data.status == 'active' ||
        isAdmin();

      allow write: if isAdmin();
    }

    match /caseStudies/{caseStudyId} {
      allow read: if
        resource.data.status == 'PUBLISHED' ||
        resource.data.status == 'published' ||
        resource.data.status == 'active' ||
        isAdmin();

      allow write: if isAdmin();
    }

    // PAGE SECTIONS

    match /page_sections/{sectionId} {
      allow read: if
        resource.data.status == 'PUBLISHED' ||
        resource.data.status == 'published' ||
        resource.data.status == 'active' ||
        resource.data.published == true ||
        isAdmin();

      allow write: if isAdmin();
    }

    // SETTINGS

    match /settings/email {
      allow read, write: if false;
    }

    match /settings/admin_auth {
      allow read, write: if false;
    }

    match /settings/{settingId} {
      allow read: if
        settingId != 'email' &&
        settingId != 'admin_auth';

      allow write: if isAdmin();
    }

    // SERVICE REQUESTS

    match /serviceRequests/{requestId} {
      allow create: if true;
      allow get: if true;
      allow list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /requests/{requestId} {
      allow create: if true;
      allow get: if true;
      allow list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // BOOKINGS

    match /bookings/{bookingId} {
      allow create: if true;
      allow get: if true;
      allow list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // INQUIRIES / CONTACTS

    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /contacts/{contactId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // CUSTOMERS

    match /customers/{customerId} {
      allow read, write: if isAdmin();
    }

    // MEDIA

    match /media/{mediaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ACTIVITY LOGS

    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow create: if true;
    }

    // USERS

    match /users/{userId} {
      allow read: if
        isAuth() &&
        (
          request.auth.uid == userId ||
          isAdmin()
        );

      allow write: if
        isAuth() &&
        (
          request.auth.uid == userId ||
          isAdmin()
        );
    }

    // DEFAULT DENY

    match /{document=**} {
      allow read, write: if false;
    }
  }
}