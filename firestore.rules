rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    // Verify administrator authority via custom auth claim, verified admin email, or user profile role
    function isAdmin() {
      return isAuth() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'ullahsafiullah117@gmail.com' ||
        request.auth.token.email == 'sullahjan40@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Services: Public visitors can only view published services; only admin can edit/publish/delete
    match /services/{serviceId} {
      allow read: if resource.data.status == 'PUBLISHED' || resource.data.status == 'published' || resource.data.status == 'active' || isAdmin();
      allow write: if isAdmin();
    }

    // FAQ: Public visitors can only view published FAQs; only admin can manage
    match /faq/{faqId} {
      allow read: if resource.data.status == 'PUBLISHED' || resource.data.status == 'published' || resource.data.status == 'active' || isAdmin();
      allow write: if isAdmin();
    }

    // Real Service Cases: Public can only view published cases; only admin can manage
    match /caseStudies/{caseStudyId} {
      allow read: if resource.data.status == 'PUBLISHED' || resource.data.status == 'published' || resource.data.status == 'active' || isAdmin();
      allow write: if isAdmin();
    }

    // Settings: Public can read general site config; sensitive server-only docs (email, admin_auth) strictly blocked from client SDK
    match /settings/email {
      allow read, write: if false; // Accessible ONLY via server-side Firebase Admin SDK
    }

    match /settings/admin_auth {
      allow read, write: if false; // Accessible ONLY via server-side Firebase Admin SDK
    }

    match /settings/{settingId} {
      allow read: if settingId != 'email' && settingId != 'admin_auth';
      allow write: if isAdmin();
    }

    // Service Requests: Public can create requests & look up their own specific reference ID (get); only admin can list or update
    match /serviceRequests/{requestId} {
      allow create: if true;
      allow get: if true;
      allow list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /requests/{requestId} {
      allow create: if true;
      allow get: if true;
      allow list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Bookings: Public can create; only admin can list or update status
    match /bookings/{bookingId} {
      allow create: if true;
      allow get: if true;
      allow list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Inquiries: Public can submit; only admin can read and manage
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /contacts/{contactId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Customers: Strictly private customer profiles; only admin can access
    match /customers/{customerId} {
      allow read, write: if isAdmin();
    }

    // Media: Public can view assets; only admin can upload or delete
    match /media/{mediaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Activity Logs: Admin-only audit trail
    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow create: if true;
    }

    // User accounts management
    match /users/{userId} {
      allow read: if isAuth() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuth() && (request.auth.uid == userId || isAdmin());
    }
  }
}
